# ==============================================================================
# Constructora Cuatropuntas SpA - Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# Copia este archivo a .env y .env.local y completa con los valores reales.
# NUNCA subas credenciales reales a GitHub.

# --- Google Gemini AI (Asesor Comercial & WhatsApp Bot) ---
GEMINI_API_KEY="AIzaSy..."

# --- Meta WhatsApp Cloud API (Captura y Funnel Automatizado) ---
# Número Oficial Bot: +56 9 2738 4075
WHATSAPP_TOKEN="EAAU..."
WHATSAPP_PHONE_NUMBER_ID="1221676334362871"
WHATSAPP_VERIFY_TOKEN="cuatropuntas_webhook_secret_2026"

# --- Cal.com Agendamiento de Visitas Técnicas ---
# Visita Técnica Oficial: https://cal.com/cuatropuntas.com/visita-tecnica
# Secreto opcional para validación de firma HMAC SHA256 del Webhook
CAL_WEBHOOK_SECRET=""

# --- Persistencia Fail-Safe de Leads (Google Sheets) ---
# Webhook HTTPS de Google Apps Script para almacenar prospectos antes de SMTP
GOOGLE_SHEETS_WEBHOOK_URL=""

# --- Servidor de Correo Transaccional (Zoho Mail SMTP) ---
ZOHO_USER="contacto@cuatropuntas.com"
ZOHO_PASS=""
ADMIN_EMAIL="contacto@cuatropuntas.com"

# --- Pipeline y Motor Automatizado de Publicación del Blog (Spec 003) ---
# Secreto para autenticación Bearer Token en POST /api/blog-publish
BLOG_PUBLISH_SECRET="tu_secreto_seguro_para_publicar_blog"

# --- Piloto Automático Semanal en GitHub Actions (Spec 004) ---
# Secreto requerido en GitHub Actions Secrets (Settings > Secrets and variables > Actions)
# GEMINI_API_KEY o GOOGLE_GENERATIVE_AI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# --- Sistema de Comentarios & Email Marketing (Spec 005) ---
# Client ID de Google Cloud Console para Google Identity Services ("Continuar con Google")
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"


